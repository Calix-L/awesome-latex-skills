{
  "schema": 1,
  "cases": [
    {
      "id": "rescue-errors",
      "skill": "latex-rescue",
      "inputs": [
        {
          "source": "examples/rescue/input.tex",
          "name": "input.tex"
        }
      ],
      "prompt": "Repair the supplied LaTeX syntax minimally. Retain all table values, unknown reference/citation keys, and the ambiguous original expression; show unresolved meaning visibly. Write output.tex and report.md, or analysis.md and report.md for reading.",
      "checks": [
        {
          "id": "accuracy",
          "file": "output.tex",
          "operation": "contains",
          "value": "76.10"
        },
        {
          "id": "spread",
          "file": "output.tex",
          "operation": "contains",
          "value": "0.30"
        },
        {
          "id": "unknown-ref",
          "file": "output.tex",
          "operation": "contains",
          "value": "\\ref{sec:missing}"
        },
        {
          "id": "unknown-citation",
          "file": "output.tex",
          "operation": "contains",
          "value": "\\cite{missing2024}"
        },
        {
          "id": "original-math",
          "file": "output.tex",
          "operation": "contains",
          "value": "x^a^b"
        },
        {
          "id": "visible-uncertainty",
          "file": "output.tex",
          "operation": "contains",
          "value": "[UNCERTAIN:"
        },
        {
          "id": "typo-fixed",
          "file": "output.tex",
          "operation": "absent",
          "value": "\\textbff"
        }
      ],
      "review": [
        {
          "id": "meaning",
          "question": "Are scientific claims, numbers, conditions and logical relations preserved?"
        },
        {
          "id": "coverage",
          "question": "Does the output cover the requested material without hiding omissions?"
        },
        {
          "id": "uncertainty",
          "question": "Are missing evidence and author decisions visible without invented content?"
        },
        {
          "id": "evidence",
          "question": "Are changes and conclusions grounded in source locations and actual checks?"
        }
      ]
    },
